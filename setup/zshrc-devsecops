# ============================================
# FUNÇÕES ÚTEIS
# ============================================

# Criar projeto seguro rápido
newproject() {
  local name=$1
  local lang=${2:-python}
  mkdir -p "$name" && cd "$name"
  git init
  case $lang in
    python)
      python3 -m venv .venv
      touch .env .env.example README.md pyproject.toml .gitignore
      cat > .gitignore << 'EOF'
.venv/
__pycache__/
*.pyc
.env
.env.local
*.egg-info/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
EOF
      echo "PROJECT_NAME=$name" > .env.example
      echo "✅ Projeto Python criado: $name"
      ;;
    go)
      go mod init "github.com/$name"
      touch main.go .gitignore
      echo "✅ Projeto Go criado: $name"
      ;;
    rust)
      cargo init "$name" 2>/dev/null || (cargo init && cd -)
      echo "✅ Projeto Rust criado: $name"
      ;;
    node|ts)
      npm init -y
      touch .env .env.example
      echo "✅ Projeto Node criado: $name"
      ;;
  esac
}

# Scan rápido de segurança
quick-scan() {
  local target=${1:-.}
  echo "🔍 Iniciando scan rápido em: $target"
  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  echo "📋 [1/4] Semgrep (SAST)..."
  semgrep --config=auto --error "$target" 2>/dev/null
  echo ""
  echo "🔑 [2/4] Gitleaks (Secrets)..."
  gitleaks detect --path "$target" --verbose --redact 2>/dev/null
  echo ""
  echo "📦 [3/4] Trivy (Vulnerabilidades)..."
  trivy fs --severity HIGH,CRITICAL "$target" 2>/dev/null
  echo ""
  echo "🐍 [4/4] Bandit (Python SAST)..."
  bandit -r "$target" -ll --format json 2>/dev/null | jq -r '.results[] | "  ⚠️  \(.filename):\(.line_number) - \(.issue_text)"' 2>/dev/null
  echo ""
  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  echo "✅ Scan completo!"
}

# Docker scan
dk-scan() {
  local image=$1
  if [ -z "$image" ]; then
    echo "Uso: dk-scan <image:tag>"
    return 1
  fi
  echo "🔍 Scanning image: $image"
  trivy image --severity MEDIUM,HIGH,CRITICAL "$image"
}

# Git commit seguro (com pre-commit)
gcs() {
  local msg=$1
  if [ -z "$msg" ]; then
    echo "Uso: gcs 'message'"
    return 1
  fi
  git add -A
  pre-commit run --all-files && git commit -m "$msg" || echo "❌ Pre-commit falhou"
}

# Backup dotfiles rápido
backup-dotfiles() {
  local dir="$HOME/dotfiles-backup/$(date +%Y%m%d_%H%M%S)"
  mkdir -p "$dir"
  cp ~/.zshrc "$dir/"
  cp ~/.gitconfig "$dir/"
  cp ~/.config/opencode/opencode.json "$dir/"
  cp ~/.config/starship.toml "$dir/" 2>/dev/null
  cp ~/.pre-commit-config.yaml "$dir/" 2>/dev/null
  echo "✅ Dotfiles salvos em: $dir"
}

