  git
  zsh-autosuggestions
  zsh-syntax-highlighting
  zsh-completions
  docker
  docker-compose
  golang
  rust
  cargo
  python
  pip
  poetry
  npm
  node
  fzf
  z
  sudo
  command-not-found
  history
  copypath
  copyfile
)

source $ZSH/oh-my-zsh.sh

# ============================================
# STARSHIP PROMPT
# ============================================
eval "$(starship init zsh)"

# ============================================
# ALIASES - OPENCODE & 9ROUTER
# ============================================
alias oficina="oficina"  # Já configurado pelo user
alias oc="opencode"
alias oc-up="opencode serve &"
alias oc-status="opencode status 2>/dev/null || echo 'Verifique se o 9Router está rodando'"

# ============================================
# ALIASES - SEGURANÇA (SAST/SCA/Secrets)
# ============================================
alias sec-scan="semgrep --config=auto . && trivy fs --severity HIGH,CRITICAL . && gitleaks detect --verbose"
alias sec-semgrep="semgrep --config=auto --error ."
alias sec-trivy="trivy fs --severity MEDIUM,HIGH,CRITICAL ."
alias sec-trivy-docker="trivy config --severity MEDIUM,HIGH,CRITICAL Dockerfile"
alias sec-gitleaks="gitleaks detect --verbose --redact"
alias sec-bandit="bandit -r . -f json -ll"
alias sec-full="sec-scan && bandit -r src/ -ll && echo '✅ Scan completo'"
alias sec-deps="pip-audit && npm audit --audit-level=high 2>/dev/null; echo '---'; trivy sbom $(syft . -o spdx-json) 2>/dev/null || trivy fs ."

# ============================================
# ALIASES - DOCKER
