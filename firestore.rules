rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // HELPERS DE AUTENTICACAO
    // ============================================================

    function isAuth() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuth() && request.auth.token.email in [
        "fabriciapodologa@gmail.com"
      ];
    }

    // ============================================================
    // PACIENTES — Dados medicos sensiveis (LGPD)
    // ============================================================
    match /patients/{patientId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // ============================================================
    // AGENDAMENTOS
    // ============================================================
    match /appointments/{appointmentId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // ============================================================
    // FINANCAS — APENAS ADMIN
    // ============================================================
    match /finances/{financeId} {
      allow read, create, update, delete: if isAdmin();
    }

    // ============================================================
    // SERVICOS — Leitura publica, escrita admin
    // ============================================================
    match /services/{serviceId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ============================================================
    // BLOCKED DAYS — APENAS ADMIN
    // ============================================================
    match /appData/{document} {
      allow read, create, update, delete: if isAdmin();
    }

    // ============================================================
    // BLOQUEIOS NATIVOS — Leitura publica, escrita admin
    // ============================================================
    match /scheduleBlocks/{blockId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ============================================================
    // CONFIGURACOES DA CLINICA — Leitura publica, escrita admin
    // ============================================================
    match /clinicSettings/{document} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ============================================================
    // ESTOQUE — APENAS ADMIN
    // ============================================================
    match /inventoryProducts/{productId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /inventoryLots/{lotId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /inventoryInstruments/{instrumentId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /inventoryDiscards/{discardId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /inventoryKits/{kitId} {
      allow read, create, update, delete: if isAdmin();
    }
  }
}
