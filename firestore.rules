rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Coleções admin — só autenticado
    match /inventoryProducts/{id} {
      allow read, write: if request.auth != null;
    }
    match /inventoryLots/{id} {
      allow read, write: if request.auth != null;
    }
    match /inventoryInstruments/{id} {
      allow read, write: if request.auth != null;
    }
    match /inventoryDiscards/{id} {
      allow read, write: if request.auth != null;
    }
    match /inventoryKits/{id} {
      allow read, write: if request.auth != null;
    }
    match /stock_history/{id} {
      allow read, write: if request.auth != null;
    }
    match /scheduleBlocks/{id} {
      allow read, write: if request.auth != null;
    }
    match /finance/{id} {
      allow read, write: if request.auth != null;
    }
    match /clinics/{clinicId}/{document=**} {
      allow read, write: if request.auth != null;
    }

    // Coleções públicas — portal do cliente
    match /services/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /appointments/{id} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if request.auth != null;
    }
    match /patients/{id} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if request.auth != null;
    }
  }
}
