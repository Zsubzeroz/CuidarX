rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // REGRAS GERAIS — Banco de dados ABERTO por design
    // Este app nao utiliza autenticacao do Firebase (sem senha).
    // O portal publico de agendamento do cliente precisa ler e
    // criar registros SEM login. Por isso, todas as colecoes
    // permitem leitura/escrita publica.
    // NOTA: por nao haver autenticacao, a protecao dos dados
    // depende dos controles de acesso do ambiente (ex.: hosting
    // com regras de acesso) e de boas praticas de privacidade.
    // Se um dia o app adotar login, substitua `if true` pelas
    // funcoes isAuth()/isAdmin() abaixo.
    // ============================================================

    // Helper: verifica se o usuario esta autenticado
    function isAuth() {
      return request.auth != null;
    }

    // Helper: verifica se o usuario e administrador
    function isAdmin() {
      return isAuth() && request.auth.token.admin == true;
    }

    // ============================================================
    // PACIENTES — Dados medicos sensiveis (LGPD)
    // Inclui: prontuarios, historico de evolucao, patologias dos pes.
    // ============================================================
    match /patients/{patientId} {
      allow read, create, update, delete: if true;
    }

    // ============================================================
    // AGENDAMENTOS
    // ============================================================
    match /appointments/{appointmentId} {
      allow read, create, update, delete: if true;
    }

    // ============================================================
    // FINANCAS — Dados financeiros sensiveis
    // ============================================================
    match /finances/{financeId} {
      allow read, create, update, delete: if true;
    }

    // ============================================================
    // SERVICOS — Catalogo de procedimentos
    // CRUD completo (criar, editar valor/duracao, excluir) em tempo real.
    // ============================================================
    match /services/{serviceId} {
      allow read, create, update, delete: if true;
    }

    // ============================================================
    // BLOCKED DAYS — Bloqueios de horarios (Painel Web Admin)
    // Estrutura: appData/blockedDays { items: [...] }
    // ============================================================
    match /appData/{document} {
      allow read, create, update, delete: if true;
    }

    // ============================================================
    // BLOQUEIOS NATIVOS (colecao scheduleBlocks)
    // ============================================================
    match /scheduleBlocks/{blockId} {
      allow read, create, update, delete: if true;
    }

    // ============================================================
    // CONFIGURACOES DA CLINICA (horario de expediente, etc.)
    // ============================================================
    match /clinicSettings/{document} {
      allow read, create, update, delete: if true;
    }

    // ============================================================
    // PORTAL PUBLICO DE AGENDAMENTO
    // O cliente agenda SEM login: o frontend publico le servicos
    // e cria pacientes/agendamentos diretamente. Por isso as
    // colecoes acima usam `allow ... if true` (leitura e criacao
    // publicas + atualizacao/exclusao livres para o funcionamento
    // completo do app sem senha do Firebase).
    // ============================================================
  }
}
