rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // HELPERS DE AUTENTICACAO
    // ============================================================

    function isAuth() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuth() && request.auth.token.email in [
        "fabriciapodologa@gmail.com"
      ];
    }

    // ============================================================
    // PACIENTES — Dados medicos sensiveis (LGPD)
    // Risco alto: prontuarios, diagnostico, alergias, diabete.
    // Apenas admin pode ler/escrever. NUNCA publico.
    // ============================================================
    match /patients/{patientId} {
      allow create: if isAdmin();
      allow read: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ============================================================
    // AGENDAMENTOS
    // PUBLICO: pode criar (portal de agendamento online)
    // ADMIN: pode ler/atualizar/excluir qualquer agendamento
    // ============================================================
    match /appointments/{appointmentId} {
      allow create: if true;
      allow read: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ============================================================
    // FINANCAS — APENAS ADMIN (LGPD financeira)
    // ============================================================
    match /finances/{financeId} {
      allow create: if isAdmin();
      allow read: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ============================================================
    // SERVICOS — Leitura publica (portal), escrita admin
    // ============================================================
    match /services/{serviceId} {
      allow read: if true;
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ============================================================
    // DADOS DA APLICACAO — APENAS ADMIN
    // ============================================================
    match /appData/{document} {
      allow create: if isAdmin();
      allow read: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ============================================================
    // BLOQUEIOS DE HORARIO — Leitura publica, escrita admin
    // ============================================================
    match /scheduleBlocks/{blockId} {
      allow read: if true;
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ============================================================
    // CONFIGURACOES DA CLINICA — Leitura publica, escrita admin
    // ============================================================
    match /clinicSettings/{document} {
      allow read: if true;
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ============================================================
    // ESTOQUE — APENAS ADMIN (dados operacionais sensiveis)
    // ============================================================
    match /inventoryProducts/{productId} {
      allow create: if isAdmin();
      allow read: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /inventoryLots/{lotId} {
      allow create: if isAdmin();
      allow read: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /inventoryInstruments/{instrumentId} {
      allow create: if isAdmin();
      allow read: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /inventoryDiscards/{discardId} {
      allow create: if isAdmin();
      allow read: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /inventoryKits/{kitId} {
      allow create: if isAdmin();
      allow read: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
  }
}
