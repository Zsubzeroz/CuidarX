rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Get user's clinicId and role
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function getUserClinicId() {
      return getUserData().clinicId;
    }

    function getUserRole() {
      return getUserData().role;
    }

    function isOwnerOrAdmin() {
      return getUserRole() in ["owner", "admin"];
    }

    function isClinicMember(clinicId) {
      return request.auth != null && getUserClinicId() == clinicId;
    }

    function isClinicOwnerOrAdmin(clinicId) {
      return isClinicMember(clinicId) && isOwnerOrAdmin();
    }

    // ============================================================
    // USERS - só o próprio usuário pode ler/escrever seu perfil
    // ============================================================
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid;
    }

    // ============================================================
    // CLINICS - owner/admin gerencia, membros leem
    // ============================================================
    match /clinics/{clinicId} {
      allow read: if isClinicMember(clinicId);
      allow write: if isClinicOwnerOrAdmin(clinicId);
      allow create: if request.auth != null;

      // Subcollections scoped to clinic
      match /{collection}/{docId} {
        allow read: if isClinicMember(clinicId);
        allow write: if isClinicMember(clinicId);
      }

      // Public access for active clinics (listing, portal)
      allow read: if resource.data.subscription.status == "active" 
        || (resource.data.createdAt != null && resource.data.createdAt > timestamp.date(now()) - duration.value(30, 'd'));
    }

    // ============================================================
    // PATIENTS - admin CRUD, portal create (agendamento)
    // ============================================================
    match /clinics/{clinicId}/patients/{patientId} {
      allow read: if isClinicMember(clinicId);
      allow create: if isClinicMember(clinicId) || (resource.data.source == "portal");
      allow update, delete: if isClinicMember(clinicId);
    }

    // ============================================================
    // APPOINTMENTS - admin CRUD, portal create/read
    // ============================================================
    match /clinics/{clinicId}/appointments/{appointmentId} {
      allow read: if isClinicMember(clinicId) || resource.data.source == "portal";
      allow create: if true; // portal e admin
      allow update, delete: if isClinicMember(clinicId);
    }

    // ============================================================
    // FINANCES - apenas clínica
    // ============================================================
    match /clinics/{clinicId}/finances/{financeId} {
      allow read, write: if isClinicMember(clinicId);
    }

    // ============================================================
    // SERVICES - admin CRUD, portal read (apenas ativos)
    // ============================================================
    match /clinics/{clinicId}/services/{serviceId} {
      allow read: if isClinicMember(clinicId) || (resource.data.isActive == true);
      allow write: if isClinicMember(clinicId);
    }

    // ============================================================
    // SCHEDULE BLOCKS - admin CRUD, portal read (espelho público)
    // ============================================================
    match /clinics/{clinicId}/scheduleBlocks/{blockId} {
      allow read, write: if isClinicMember(clinicId);
    }

    match /clinics/{clinicId}/publicScheduleBlocks/{blockId} {
      allow read: if true; // público para portal
      allow write: if isClinicMember(clinicId);
    }

    // ============================================================
    // BLOCKED DAYS (appData) - apenas clínica
    // ============================================================
    match /clinics/{clinicId}/appData/{docId} {
      allow read, write: if isClinicMember(clinicId);
    }

    // ============================================================
    // INVENTORY - apenas clínica
    // ============================================================
    match /clinics/{clinicId}/inventoryProducts/{productId} {
      allow read, write: if isClinicMember(clinicId);
    }

    match /clinics/{clinicId}/inventoryLots/{lotId} {
      allow read, write: if isClinicMember(clinicId);
    }

    match /clinics/{clinicId}/inventoryInstruments/{instrumentId} {
      allow read, write: if isClinicMember(clinicId);
    }

    match /clinics/{clinicId}/inventoryDiscards/{discardId} {
      allow read, write: if isClinicMember(clinicId);
    }

    match /clinics/{clinicId}/inventoryKits/{kitId} {
      allow read, write: if isClinicMember(clinicId);
    }

    match /clinics/{clinicId}/stock_history/{historyId} {
      allow read, write: if isClinicMember(clinicId);
    }

    // ============================================================
    // SYSTEM LOGS - apenas clínica (write)
    // ============================================================
    match /clinics/{clinicId}/systemLogs/{logId} {
      allow write: if isClinicMember(clinicId);
      allow read: if isClinicOwnerOrAdmin(clinicId);
    }

    // ============================================================
    // OAUTH SESSIONS - para OAuth nativo (legacy, pode remover)
    // ============================================================
    match /oauth_sessions/{sessionId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if request.auth != null;
    }
  }
}