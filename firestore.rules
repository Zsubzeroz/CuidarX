rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Regras para Coleções de Estoque (Nível Raiz)
    match /inventoryProducts/{id} {
      allow read, write: if true;
    }
    match /inventoryLots/{id} {
      allow read, write: if true;
    }
    match /inventoryInstruments/{id} {
      allow read, write: if true;
    }
    match /inventoryDiscards/{id} {
      allow read, write: if true;
    }
    match /inventoryKits/{id} {
      allow read, write: if true;
    }
    match /stock_history/{id} {
      allow read, write: if true;
    }

    // Demais coleções do sistema
    match /appointments/{id} {
      allow read, write: if true;
    }
    match /patients/{id} {
      allow read, write: if true;
    }
    match /scheduleBlocks/{id} {
      allow read, write: if true;
    }
    match /finance/{id} {
      allow read, write: if true;
    }
    match /services/{id} {
      allow read, write: if true;
    }
    match /clinics/{clinicId}/{document=**} {
      allow read, write: if true;
    }
  }
}
