# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Firebase Cloud Firestore Connection Settings (Server-side):
# Configure these to connect to your real Firebase console project (e.g. "podologa-fabricia").
FIREBASE_API_KEY=""
FIREBASE_AUTH_DOMAIN=""
FIREBASE_PROJECT_ID="podologa-fabricia"
FIREBASE_STORAGE_BUCKET=""
FIREBASE_MESSAGING_SENDER_ID=""
FIREBASE_APP_ID=""

# Client-side Firebase (exposed to browser via Vite, prefixed with VITE_)
# These enable real-time Firestore sync directly from the browser.
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID="podologa-fabricia"
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# Google Calendar Integration (Client-side OAuth2)
# Create at https://console.cloud.google.com/apis/credentials
# Enable Google Calendar API and set OAuth consent screen
VITE_GOOGLE_CALENDAR_CLIENT_ID=""
