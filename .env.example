# ============================================
# CuidarX - Configuracao da Clinica
# ============================================

# Nome da clinica exibido no sistema
VITE_CLINIC_NAME="Nome da Sua Clinica"

# Nome do(a) profissional responsible
VITE_DOCTOR_NAME="Dra. Profissional"

# Especialidade medica
VITE_DOCTOR_SPECIALTY="Podologia"

# E-mail Google autorizado a acessar o painel administrativo
VITE_AUTHORIZED_ADMIN_EMAIL="seu-email@gmail.com"

# URL publica do sistema (ex: https://cuidarx.web.app)
VITE_CLINIC_URL=""

# ID do aplicativo Android (ex: com.minhaclinica.app)
VITE_APP_ID="com.cuidarx.app"

# Caminho do logo (ex: /logo.png)
VITE_LOGO_PATH="/logo.png"

# Cores do tema (hex)
VITE_PRIMARY_COLOR="#0B4C33"
VITE_ACCENT_COLOR="#CBAA6C"

# ============================================
# Firebase (Server-side)
# ============================================
GEMINI_API_KEY=""
APP_URL=""
FIREBASE_API_KEY=""
FIREBASE_AUTH_DOMAIN=""
FIREBASE_PROJECT_ID=""
FIREBASE_STORAGE_BUCKET=""
FIREBASE_MESSAGING_SENDER_ID=""
FIREBASE_APP_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# ============================================
# Firebase (Client-side, exposto ao browser via VITE_)
# ============================================
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# ============================================
# Google Calendar (Client-side OAuth2)
# ============================================
VITE_GOOGLE_CALENDAR_CLIENT_ID=""
